{
  "name": "stratamm",
  "version": "0.0.0",
  "private": true,
  "description": "Strassen–Winograd matrix multiplication for stdlib (dgemmsw) and an evidence study of fast matrix multiplication in JavaScript.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeKaustubh07/StrataMM.git"
  },
  "scripts": {
    "test": "tape 'lib/node_modules/@stdlib/blas/ext/base/dgemmsw/test/test*.js'",
    "test:cov": "bash etc/coverage.sh",
    "test:mutation": "node etc/mutation/run.js",
    "lint": "bash etc/lint.sh",
    "build": "npm run lint && npm test",
    "examples": "node lib/node_modules/@stdlib/blas/ext/base/dgemmsw/examples/index.js",
    "bench:pkg": "node lib/node_modules/@stdlib/blas/ext/base/dgemmsw/benchmark/benchmark.js && node lib/node_modules/@stdlib/blas/ext/base/dgemmsw/benchmark/benchmark.ndarray.js"
  },
  "engines": {
    "node": ">=0.10.0",
    "npm": ">2.7.0"
  },
  "dependencies": {
    "@stdlib/array": "0.5.1",
    "@stdlib/assert": "0.4.1",
    "@stdlib/blas": "0.4.1",
    "@stdlib/constants": "0.4.1",
    "@stdlib/math": "0.4.1",
    "@stdlib/ndarray": "0.4.1",
    "@stdlib/strided": "0.4.1",
    "@stdlib/string": "0.4.1",
    "@stdlib/utils": "0.4.1"
  },
  "devDependencies": {
    "@stdlib/bench": "0.5.1",
    "@stdlib/number": "0.4.1",
    "@stdlib/random": "0.4.1",
    "c8": "7.14.0",
    "proxyquire": "2.1.3",
    "tape": "4.5.1"
  }
}
